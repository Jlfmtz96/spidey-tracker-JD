<div class="tracker-wrapper">
  <div class="frame">
    <!-- Bordes superiores -->
    <div class="slice tl"></div>
    <div class="slice t"></div>
    <div class="slice tr"></div>

    <!-- Borde izquierdo -->
    <div class="slice l"></div>
    
    <!-- Contenedor central (Bezel) -->
    <div class="bezel">
      
      <!-- LOGO FLOTANTE SUPERIOR -->
      <header class="titlebar">
        <img src="/tracker_logo3.png" alt="Spidey Tracker" class="logo" />
      </header>

      <!-- PANTALLA (El único elemento que ocupa espacio aquí adentro) -->
      <div class="screen">
        <slot />
      </div>

      <!-- BOTÓN FLOTANTE INFERIOR -->
      <div class="sound-status">
        <span>SELECCIONA UNA OPCIÓN DE SONIDO</span>
      </div>

    </div>
    
    <!-- Borde derecho -->
    <div class="slice r"></div>

    <!-- NUEVA FILA 3: Sombra / Banda intermedia (Frame 3) -->
    <div class="slice shadow-l"></div>
    <div class="slice shadow-c"></div>
    <div class="slice shadow-r"></div>

    <!-- Bordes inferiores -->
    <div class="slice bl"></div>
    <div class="slice b"></div>
    <div class="slice br"></div>

    <!-- Remate de sombra (Frame 5) -->
    <div class="slice strip-l"></div>
    <div class="slice strip-c"></div>
    <div class="slice strip-r"></div>
  </div>

  <div class="external-footer">
    <div class="hanging-buttons">
      <!-- <a class="btn-retro" href="#" aria-label="Ver tráiler">VER TRÁILER</a> -->
      <!-- Cambiamos a button con un ID para abrir el modal -->
      <button class="btn-retro" id="btn-rsvp" aria-label="Confirma tu asistencia">CONFIRMAR ASISTENCIA</button>
    </div>
    
    <!-- PROMO CENTER A 2 COLUMNAS -->
    <div class="promo-center">
      <div class="promo-col">
        <p class="film-title">¡ESTÁS INVITADO!</p>
        <p class="film-now">A UNA FIESTA ÉPICA</p>
      </div>
      
      <div class="promo-divider"></div>
      
      <div class="promo-col">
        <p class="presented">CELEBRANDO EL CUMPLEAÑOS DE</p>
        <p class="birthday-name">JOSÉ DAVID</p>
      </div>
    </div>
  </div>
</div>

<!-- MODAL DE RSVP (Nativo de HTML5) -->
<dialog id="rsvp-modal" class="retro-modal">
  <div class="modal-content">
    <button id="close-modal" class="close-btn" aria-label="Cerrar">✕</button>
    <h2>ESTATUS DEL AGENTE: CONFIRMAR ASISTENCIA</h2>
    
    <form id="rsvp-form">
      <div class="form-group">
        <label>NOMBRE CLAVE (Tu nombre completo):</label>
        <input type="text" name="nombre" required />
      </div>
      <div class="form-group">
        <label>AGENTES ACOMPAÑANTES:</label>
        <input type="number" name="acompanantes" min="0" max="10" value="0" />
      </div>
      <button type="submit" class="btn-retro submit-btn">ENVIAR CONFIRMACIÓN</button>
    </form>
  </div>
</dialog>

<script>
  // Lógica Vanilla JS para controlar el modal dentro de Astro
  const modal = document.getElementById('rsvp-modal') as HTMLDialogElement;
  const btnRsvp = document.getElementById('btn-rsvp');
  const btnClose = document.getElementById('close-modal');
  const form = document.getElementById('rsvp-form') as HTMLFormElement;

  if (btnRsvp && modal && btnClose) {
    btnRsvp.addEventListener('click', () => modal.showModal());
    btnClose.addEventListener('click', () => modal.close());
    
    // Cerrar al hacer clic fuera del modal
    modal.addEventListener('click', (e) => {
      const dialogDimensions = modal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left || e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top || e.clientY > dialogDimensions.bottom
      ) {
        modal.close();
      }
    });
  }

  if (form) {
form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('.submit-btn');
      const originalText = submitBtn.textContent;
      submitBtn.textContent = "ENVIANDO DATOS...";
      submitBtn.style.backgroundColor = "#5ec8e8"; 
      
      const formData = new FormData(form);
      
      // ¡TRUCO NUEVO! Convertimos los datos al formato exacto que Google espera leer
      const data = new URLSearchParams();
      for (const pair of formData) {
          data.append(pair[0], pair[1]);
      }
      
      try {
        const scriptURL = 'https://script.google.com/macros/s/AKfycbxBd6z8WAproX_j0bz8C4P44oncj-abZjo-245mYDp-tKHWeQIZUI-UjWTKHQvAbNqj/exec';
        
        // Enviamos la variable "data" en lugar de "formData"
        await fetch(scriptURL, { 
          method: 'POST', 
          body: data, 
          mode: 'no-cors' 
        });
        
        await new Promise(resolve => setTimeout(resolve, 1000));

        submitBtn.textContent = "¡MISIÓN ACEPTADA!";
        setTimeout(() => {
          modal.close();
          form.reset();
          submitBtn.textContent = originalText;
          submitBtn.style.backgroundColor = "#fca02d";
        }, 2000);

      } catch (error) {
        console.error('Error!', error.message);
        submitBtn.textContent = "ERROR. REINTENTA.";
        submitBtn.style.backgroundColor = "#ff3b3b";
      }
    });
  }
</script>

<style>
