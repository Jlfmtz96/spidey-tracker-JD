    background-repeat: no-repeat;
  }

  .tl {
    background-image: url("/images/frame/frame1-1.png");
    background-size: 100% 100%;
  }
  .t {
    background-image: url("/images/frame/frame1-2.png");
    background-repeat: repeat-x;
    background-size: auto 100%;
  }
  .tr {
    background-image: url("/images/frame/frame1-3.png");
    background-size: 100% 100%;
  }
  .l {
    background-image: url("/images/frame/frame2-1.png");
    background-repeat: repeat-y;
    background-size: 100% auto;
  }
  .r {
    background-image: url("/images/frame/frame2-3.png");
    background-repeat: repeat-y;
    background-size: 100% auto;
  }

  .shadow-l {
    background-image: url("/images/frame/frame3-1.png");
    background-size: 100% 100%;
  }
  .shadow-c {
    background-image: url("/images/frame/frame3-2.png");
    background-repeat: repeat-x;
    background-size: auto 100%;
  }
  .shadow-r {
    background-image: url("/images/frame/frame3-3.png");
    background-size: 100% 100%;
  }

  .bl {
    background-image: url("/images/frame/frame4-1.png"); /* Cambiado de 5 a 4 */
    background-size: 100% 100%;
  }
  .b {
    background-image: url("/images/frame/frame4-2.png"); /* Cambiado de 5 a 4 */
    background-repeat: repeat-x;
    background-size: auto 100%;
  }
  .br {
    background-image: url("/images/frame/frame4-3.png"); /* Cambiado de 5 a 4 */
    background-size: 100% 100%;
  }

  .strip-l {
    background-image: url("/images/frame/frame5-1.png");
    background-size: 100% 100%;
  }
  .strip-c {
    background-image: url("/images/frame/frame5-2.png");
    background-repeat: repeat-x;
    background-size: auto 100%;
  }
  .strip-r {
    background-image: url("/images/frame/frame5-3.png");
    background-size: 100% 100%;
  }

  .bezel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--spidey-teal);
    padding: 0; /* Crea el contorno azul interno */
    position: relative; /* ¡CRÍTICO! Esto atrapa a los elementos flotantes */
  }

  .titlebar {
    position: absolute;
    top: -24px; /* Lo subimos un poco para despegarlo del marco interno */
    left: 50%;
    transform: translateX(-50%); /* Centrado matemático exacto a la mitad de la pantalla */
    z-index: 20;
    pointer-events: none; 
  }

  .logo {
    height: 48px;
    width: auto;
    image-rendering: pixelated;
  }

  .screen {
    flex: 1;
    width: 100%;
    min-height: 0;
    
    /* 1. Un color base mucho más oscuro para igualar la original */
    background-color: #212429; 
    
    background-image: 
      /* Capa 1 (Frente): Líneas horizontales intercaladas (2px transparentes, 2px oscuras) */
      repeating-linear-gradient(
        to bottom,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.35) 2px,
        rgba(0, 0, 0, 0.35) 4px
      ),
      /* Capa 2 (Medio): Sombreado en las esquinas (efecto monitor) */
      radial-gradient(circle at center, transparent 40%, rgba(0,0,0,0.6) 120%),
      /* Capa 3 (Fondo): Tu marca de agua de la araña */
      url("/SM_ASCII_DOTS_WHITE.png"); 
      
    background-repeat: repeat, no-repeat, no-repeat;
    background-position: top left, center, center;
    
    /* El tercer valor (40%) controla el tamaño de tu araña. Súbelo o bájalo según necesites */
    background-size: 100% 100%, 100% 100%, 30%; 
    
    /* Opcional: Si tu imagen de araña es muy brillante, esto la fusiona con el fondo */
    background-blend-mode: normal, normal, overlay; 

    border: 3px solid #111;
    box-shadow: inset 0 0 0 1px #1b2830;
    overflow: hidden;
    position: relative;
  }

  .sound-status {
    position: absolute;
    bottom: -76px; 
    height: 58px; 
    left: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center; 
    gap: 12px; /* Espacio entre el texto y el botón */
    z-index: 20;
  }

  .sound-toggle-btn {
    position: relative;
    background: transparent;
    border: none;
    padding: 0;
    
    /* CAMBIA ESTA MEDIDA: Antes estaba en 32px. 
       Prueba con 38px o 40px para que respire el icono */
    height: 40px; 
    
    width: 54px;  
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    pointer-events: auto;
    transition: transform 0.1s;
    image-rendering: pixelated;
  }
  .sound-toggle-btn:active {
    transform: scale(0.92);
  }

  /* --- ENSAMBLAJE DEL FONDO DEL BOTÓN --- */
  .btn-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    z-index: 1;
  }

  .btn-slice-l {
    /* Ajusta este valor (ej. 8px o 12px) si la esquina izquierda se ve estirada */
    width: 10px; 
    background-image: url('/images/btn-white-1.png');
    background-size: 100% 100%;
    background-repeat: no-repeat;
  }

  .btn-slice-c {
    flex: 1; /* Se estira automáticamente para rellenar el centro */
    background-image: url('/images/btn-white-2.png');
    background-size: auto 100%;
    background-repeat: repeat-x;
  }

  .btn-slice-r {
    /* Ajusta este valor si la esquina derecha se ve estirada */
    width: 10px; 
    background-image: url('/images/btn-white-3.png');
    background-size: 100% 100%;
    background-repeat: no-repeat;
  }

  /* --- ICONO CENTRAL --- */
  .sound-toggle-btn img {
    position: relative;
    z-index: 2; /* Se coloca por encima del fondo ensamblado */
    height: 12px; /* Hazlo más grande o chico según encaje en tus marcos */
    width: auto;
    transition: opacity 0.2s;
  }

/* --- CAJA DEL TEXTO RETRO --- */
  .status-screen {
    background: #1c2329; 
    border: 2px solid #000000;
    box-shadow: inset 0 0 0 2px #3a4b59;
    border-radius: 8px;
    height: 38px;
    flex: 1; 
    max-width: 360px;
    
    overflow: hidden; 
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center; /* ¡ESTO CENTRA LOS TEXTOS CORTOS! */
  }

  /* --- TEXTO BASE (Por defecto estático y centrado) --- */
  .marquee-text {
    color: #9eb4c6;
    font-size: 17px;
    letter-spacing: 1px;
    font-family: 'VT323', monospace;
    -webkit-font-smoothing: none;
    font-smooth: never;
    white-space: nowrap; 
    
    /* ¡NUEVO! Forzamos centrado relativo */
    position: relative;
    width: 100%;
    text-align: center;
    display: inline-block;
    
    animation: blinkTextRetro 1.2s steps(2, start) infinite;
  }

  /* Cuando JS detecta que es largo, le aplica esto: */
  .marquee-text.is-scrolling {
    position: absolute;
    text-align: left; /* Se alinea a la izquierda para poder correr */
    animation: scrollMarquee 8s linear infinite, blinkTextRetro 1.2s steps(2, start) infinite;
  }

  /* Animación mejorada para que arranque en el borde derecho exacto */
  @keyframes scrollMarquee {
    0% { left: 100%; transform: translateX(0); }
    100% { left: 0; transform: translateX(-100%); }
  }

  /* Animación de parpadeo (se queda igual) */
  @keyframes blinkTextRetro {
    0%, 100% { color: #9eb4c6; }
    50% { color: #2b3944; }
  }

