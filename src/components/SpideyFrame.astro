    /* 1. Un color base mucho más oscuro para igualar la original */
    background-color: #212429; 
    
    background-image: 
      /* Capa 1 (Frente): Líneas horizontales intercaladas (2px transparentes, 2px oscuras) */
      repeating-linear-gradient(
        to bottom,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.35) 2px,
        rgba(0, 0, 0, 0.35) 4px
      ),
      /* Capa 2 (Medio): Sombreado en las esquinas (efecto monitor) */
      radial-gradient(circle at center, transparent 40%, rgba(0,0,0,0.6) 120%),
      /* Capa 3 (Fondo): Tu marca de agua de la araña */
      url("/SM_ASCII_DOTS_WHITE.png"); 
      
    background-repeat: repeat, no-repeat, no-repeat;
    background-position: top left, center, center;
    
    /* El tercer valor (40%) controla el tamaño de tu araña. Súbelo o bájalo según necesites */
    background-size: 100% 100%, 100% 100%, 30%; 
    
    /* Opcional: Si tu imagen de araña es muy brillante, esto la fusiona con el fondo */
