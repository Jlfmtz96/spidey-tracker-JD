  /* --- AJUSTES RESPONSIVOS DEL MARCO --- *//* --- AJUSTES RESPONSIVOS DEL MARCO --- */
  @media (max-width: 768px) {
    /* 1. Logo superior */
    .logo {
      height: 32px; /* Encogemos el logo para que no invada la pantalla */
    }

    /* 2. Recuperar la marca de agua de la Araña */
    .screen {
