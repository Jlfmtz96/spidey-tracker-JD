---
import Layout from "../layouts/Layout.astro";
import SpideyFrame from "../components/SpideyFrame.astro";
import SpideyApp from "../components/SpideyApp.jsx";
---

<Layout title="Spidey Tracker | Invitación">
  <div class="page">
    {/* ELIMINAMOS los dos <aside> que contenían los círculos laterales */}
    
    <main class="tracker-container">
      <SpideyFrame>
        <SpideyApp client:only="react" />
      </SpideyFrame>
    </main>
  </div>
</Layout>

<style>
  .page {
    min-height: 100vh;
    background: #06152b; 
    /* Quitamos el display: flex de aquí para evitar que apachurre el contenido */
  }

.tracker-container {
    /* Cambiamos a min-height para que el marco pueda estirarse más si lo necesita */
    min-height: 100vh; 
    padding: 35px 20px 16px; /* Aumentamos el padding superior para que el logo respire */
    display: flex;
    flex-direction: column; 
    width: 100%;
    max-width: 1200px; 
    margin: 0 auto; 
  }

  /* --- AJUSTES RESPONSIVOS --- */
  @media (max-width: 768px) {
    .tracker-container {
      padding: 10px 0; /* En celular, que el marco toque los bordes */
    }
  }
</style>